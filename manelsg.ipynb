      "source": [
        "import pandas as pd\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "# 1. Définir le chemin d'accès au fichier\n",
        "file_path = '/content/Dataset on antimicrobial resistance of Vibrio spp. isolates across Adriatic regions (1).xlsx'\n",
        "\n",
        "# 2. Charger et nettoyer rapidement les données\n",
        "raw_df = pd.read_excel(file_path, sheet_name='Final table')\n",
        "df_clean = raw_df.copy()\n",
        "df_clean.columns = df_clean.iloc[0]\n",
        "df_clean = df_clean[1:].reset_index(drop=True)\n",
        "\n",
        "# Définir nos variables X et Y\n",
        "X = df_clean[['Region', 'Origin of data', 'Sample type', 'Species']]\n",
        "Y = df_clean[['ENR', 'FFC', 'GM', 'AM', 'E', 'T', 'SXT', 'UB', 'IPM', 'CIP', 'S', 'C']]\n",
        "\n",
        "# 3. Effectuer la division 75% entraînement et 25% vérification finale\n",
        "# Note : Nous ne stratifions pas ici pour éviter l'erreur liée aux classes sous-représentées\n",
        "X_train, X_test, Y_train, Y_test = train_test_split(\n",
        "    X,\n",
        "    Y,\n",
        "    test_size=0.25,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "# 4. Afficher le nombre exact de lignes utilisées\n",
        "print(f\"Nombre de lignes pour l'entraînement (75%) : {X_train.shape[0]}\")\n",
        "print(f\"Nombre de lignes pour la vérification finale (25%) : {X_test.shape[0]}\")\n",
        "print(f\"Nombre total de lignes dans le jeu de données : {X.shape[0]}\")"
      ],
