      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.preprocessing import OneHotEncoder\n",
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.metrics import classification_report, accuracy_score\n",
        "\n",
        "# 1. Configuration des variables explicatives et cibles existantes\n",
        "# Nous utilisons X_train, X_test, Y_train, Y_test déjà créés au cours des étapes précédentes.\n",
        "\n",
        "# Comme nos données explicatives (X) sont entièrement catégorielles, nous créons un pipeline de prétraitement avec One-Hot Encoding\n",
        "categorical_features = ['Region', 'Origin of data', 'Sample type', 'Species']\n",
        "preprocessor = ColumnTransformer(\n",
        "    transformers=[\n",
        "        ('cat', OneHotEncoder(handle_unknown='ignore'), categorical_features)\n",
        "    ]\n",
        ")\n",
        "\n",
        "# 2. Définition et entraînement d'un modèle pour chaque antibiotique\n",
        "# Puisqu'il s'agit d'un problème multi-cible (plusieurs antibiotiques), nous allons entraîner un modèle par antibiotique (Y).\n",
        "\n",
        "models = {}\n",
        "predictions = {}\n",
        "\n",
        "print(\"--- Entraînement des modèles d'apprentissage automatique (Random Forest) ---\\n\")\n",
        "\n",
        "for col in Y_train.columns:\n",
        "    # Élimination des valeurs manquantes spécifiques à cette cible dans l'entraînement\n",
        "    train_mask = Y_train[col].notna()\n",
        "    test_mask = Y_test[col].notna()\n",
        "\n",
        "    if train_mask.sum() == 0 or test_mask.sum() == 0:\n",
        "        print(f\"Sauté {col} : pas assez de données valides.\")\n",
        "        continue\n",
        "\n",
        "    X_tr_sub = X_train[train_mask]\n",
        "    y_tr_sub = Y_train[col][train_mask]\n",
        "    X_te_sub = X_test[test_mask]\n",
        "    y_te_sub = Y_test[col][test_mask]\n",
        "\n",
        "    # Création du pipeline\n",
        "    pipeline = Pipeline(steps=[\n",
        "        ('preprocessor', preprocessor),\n",
        "        ('classifier', RandomForestClassifier(random_state=42, n_estimators=100))\n",
        "    ])\n",
        "\n",
        "    # Entraînement\n",
        "    pipeline.fit(X_tr_sub, y_tr_sub)\n",
        "    models[col] = pipeline\n",
        "\n",
        "    # Évaluation\n",
        "    y_pred = pipeline.predict(X_te_sub)\n",
        "    acc = accuracy_score(y_te_sub, y_pred)\n",
        "    print(f\"Antibiotique {col:<4} | Précision (Accuracy) : {acc:.2%}\")"
      ],
      "execution_count": null,
