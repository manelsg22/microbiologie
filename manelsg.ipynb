      "source": [
        "### 3. Analyse de la liaison entre les variables catégorielles (X et Y)\n",
        "Puisque toutes les variables sont qualitatives (catégorielles), nous utilisons le **Test du Chi-deux d'indépendance** pour évaluer s'il existe une relation statistiquement significative entre les caractéristiques de l'isolat (X) et sa résistance aux antibiotiques (Y). Nous calculons également le **V de Cramér** pour mesurer la force de cette association (comprise entre 0 et 1)."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "cde05899",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 228
        },
        "outputId": "99497c2d-ea53-4f45-fb9b-d915510c8b0a"
      },
      "source": [
        "import numpy as np\n",
        "from scipy.stats import chi2_contingency\n",
        "\n",
        "# Définition des variables explicatives (X) et cibles (Y)\n",
        "variables_x = ['Region', 'Origin of data', 'Sample type', 'Species']\n",
        "variables_y = ['ENR', 'FFC', 'GM', 'AM', 'E', 'T', 'SXT', 'UB', 'IPM', 'CIP', 'S', 'C']\n",
        "\n",
        "def cramers_v(x, y):\n",
        "    \"\"\" Calcule le coefficient V de Cramér pour évaluer la force de l'association. \"\"\"\n",
        "    confusion_matrix = pd.crosstab(x, y)\n",
        "    chi2 = chi2_contingency(confusion_matrix)[0]\n",
        "    n = confusion_matrix.sum().sum()\n",
        "    phi2 = chi2 / n\n",
        "    r, k = confusion_matrix.shape\n",
        "    # Ajustement pour éviter les biais\n",
        "    phi2corr = max(0, phi2 - ((k-1)*(r-1))/(n-1))\n",
        "    rcorr = r - ((r-1)**2)/(n-1)\n",
        "    kcorr = k - ((k-1)**2)/(n-1)\n",
        "    return np.sqrt(phi2corr / min((kcorr-1), (rcorr-1)))\n",
        "\n",
        "results = []\n",
        "\n",
        "# Analyse croisée systématique\n",
        "for x_col in variables_x:\n",
        "    for y_col in variables_y:\n",
        "        # On élimine les valeurs manquantes pour l'analyse\n",
        "        temp_df = df_cleaned[[x_col, y_col]].dropna()\n",
        "        if temp_df.empty or temp_df[x_col].nunique() <= 1 or temp_df[y_col].nunique() <= 1:\n",
        "            continue\n",
        "\n",
        "        contingency_table = pd.crosstab(temp_df[x_col], temp_df[y_col])\n",
        "        chi2, p_value, _, _ = chi2_contingency(contingency_table)\n",
        "        c_v = cramers_v(temp_df[x_col], temp_df[y_col])\n",
        "\n",
        "        results.append({\n",
        "            'Variable X': x_col,\n",
        "            'Variable Y (Antibiotique)': y_col,\n",
        "            'p-value (Chi2)': p_value,\n",
        "            'V de Cramér (Force)': c_v,\n",
        "            'Significatif (<0.05)': \"Oui\" if p_value < 0.05 else \"Non\"\n",
        "        })\n",
        "\n",
        "# Conversion en DataFrame pour affichage\n",
        "analysis_df = pd.DataFrame(results)\n",
        "significant_relations = analysis_df[analysis_df['Significatif (<0.05)'] == 'Oui'].sort_values(by='V de Cramér (Force)', ascending=False)\n",
        "\n",
        "print(\"--- TOP DES LIAISONS LES PLUS FORTES (X -> Y) ---\")\n",
        "display(significant_relations.head(15))"
      ],
