      "source": [
        "import pandas as pd\n",
        "from sklearn.metrics import classification_report, accuracy_score\n",
        "\n",
        "evaluation_records = []\n",
        "\n",
        "print(\"--- ÉVALUATION STATISTIQUE DÉTAILLÉE DE L'EFFICACITÉ DU MODÈLE RANDOM FOREST ---\\n\")\n",
        "\n",
        "for col in Y_test.columns:\n",
        "    test_mask = Y_test[col].notna()\n",
        "    if test_mask.sum() == 0:\n",
        "        continue\n",
        "\n",
        "    # Récupérer y_real et y_predicted pour l'antibiotique courant\n",
        "    y_real = Y_test[col][test_mask]\n",
        "    pipeline = models[col]\n",
        "    y_predicted = pipeline.predict(X_test[test_mask])\n",
        "\n",
        "    # Calcul de la précision globale\n",
        "    acc = accuracy_score(y_real, y_predicted)\n",
        "\n",
        "    # Générer le rapport de classification détaillé\n",
        "    report = classification_report(y_real, y_predicted, output_dict=True, zero_division=0)\n",
        "\n",
        "    # Extraction des performances pour chaque classe (S, I, R)\n",
        "    for label in ['S', 'I', 'R']:\n",
        "        if label in report:\n",
        "            evaluation_records.append({\n",
        "                'Antibiotique': col,\n",
        "                'Classe': f\"Sensible (S)\" if label == 'S' else \"Intermédiaire (I)\" if label == 'I' else \"Résistant (R)\",\n",
        "                'Efficacité Globale (Accuracy)': f\"{acc:.2%}\",\n",
        "                'Précision de la classe': f\"{report[label]['precision']:.2%}\",\n",
        "                'Rappel de la classe (Recall)': f\"{report[label]['recall']:.2%}\",\n",
        "                'F1-Score de la classe': f\"{report[label]['f1-score']:.2%}\",\n",
        "                'Nombre de cas testés (Support)': int(report[label]['support'])\n",
        "            })\n",
        "\n",
        "# Conversion en DataFrame pour un affichage propre et structuré\n",
        "df_eval = pd.DataFrame(evaluation_records)\n",
        "\n",
        "# Affichage du tableau de décision d'efficacité\n",
        "display(df_eval)"
      ],
