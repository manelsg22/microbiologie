        "# 3. Visualisation de la matrice de force d'association (V de Cramér)\n",
        "pivot_v = df_results.pivot(index='Variable X', columns='Antibiotique (Y)', values='V de Cramér (Force)')\n",
        "pivot_v = pivot_v.reindex(index=variables_x, columns=variables_y)\n",
        "\n",
        "plt.figure(figsize=(14, 6))\n",
        "sns.heatmap(pivot_v, annot=True, cmap='YlOrRd', fmt=\".3f\", linewidths=.5, cbar_kws={'label': \"V de Cramér (Intensité de la liaison)\"})\n",
