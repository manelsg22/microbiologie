        "outputId": "20725297-f569-4c23-86d5-20d678672b22"
      },
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "# 1. Charger la feuille brute\n",
        "raw_df = pd.read_excel('/content/Dataset on antimicrobial resistance of Vibrio spp. isolates across Adriatic regions (1).xlsx', sheet_name='Final table')\n",
        "\n",
        "# 2. Utiliser la ligne 0 comme noms de colonnes et supprimer les lignes inutiles au début\n",
        "df_clean = raw_df.copy()\n",
        "df_clean.columns = df_clean.iloc[0]\n",
        "df_clean = df_clean[1:].reset_index(drop=True)\n",
        "\n",
        "# 3. Supprimer les lignes entièrement vides si elles existent\n",
        "df_clean = df_clean.dropna(how='all')\n",
        "\n",
        "# 4. Nettoyer les espaces blancs dans toutes les colonnes textuelles (très important pour éviter les doublons)\n",
        "for col in df_clean.columns:\n",
        "    if df_clean[col].dtype == 'object':\n",
        "        df_clean[col] = df_clean[col].astype(str).str.strip()\n",
        "        # Rétablir les vrais NaN pour les cellules qui étaient vides\n",
        "        df_clean[col] = df_clean[col].replace({'nan': np.nan, 'NA': np.nan, 'None': np.nan})\n",
        "\n",
        "# 5. Remplir ou signaler les valeurs manquantes importantes\n",
        "# Pour la région, si elle est manquante, on peut la remplacer par 'Unknown'\n",
        "if 'Region' in df_clean.columns:\n",
        "    df_clean['Region'] = df_clean['Region'].fillna('Unknown')\n",
        "\n",
        "# 6. Affichage du résultat du nettoyage\n",
        "print(\"Dimensions du dataset nettoyé :\", df_clean.shape)\n",
        "print(\"\\nNombre de valeurs manquantes par colonne :\")\n",
        "print(df_clean.isnull().sum())\n",
        "\n",
        "print(\"\\nAperçu des données propres :\")\n",
        "display(df_clean.head())"
      ],
