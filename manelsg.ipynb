      "source": [
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "# Nous définissons nos variables explicatives (X) et nos variables cibles (Y)\n",
        "# Exclusion de l'I.D. et des variables non prédictives si nécessaire\n",
        "X = df_clean[['Region', 'Origin of data', 'Sample type', 'Species']]\n",
        "Y = df_clean[['ENR', 'FFC', 'GM', 'AM', 'E', 'T', 'SXT', 'UB', 'IPM', 'CIP', 'S', 'C']]\n",
        "\n",
        "# Division 75% entraînement et 25% validation\n",
        "# Nous stratifions sur l'espèce de Vibrio pour avoir une répartition équilibrée de chaque espèce dans les deux sets\n",
        "X_train, X_test, Y_train, Y_test = train_test_split(\n",
        "    X,\n",
        "    Y,\n",
        "    test_size=0.25,\n",
        "    random_state=42,\n",
        "    stratify=X['Species']\n",
        ")\n",
        "\n",
        "# Affichage des dimensions de chaque ensemble de données\n",
        "print(f\"Dimensions du Dataset original  : {X.shape[0]} échantillons\")\n",
        "print(f\"Dimensions du Set d'entraînement (75%) : {X_train.shape[0]} échantillons\")\n",
        "print(f\"Dimensions du Set de validation   (25%) : {X_test.shape[0]} échantillons\")"
      ],
